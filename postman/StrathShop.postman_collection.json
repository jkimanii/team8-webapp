          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"every item is wellness\", () => {",
                  "  pm.response.json().forEach(l => pm.expect(l.category).to.equal(\"wellness\"));",
                  "});",
                  "pm.test(\"wellness listings carry status\", () => {",
                  "  pm.response.json().forEach(l => pm.expect(l).to.have.property(\"status\"));",
                  "});"
                ]
              }
            }
          ]
