    {
      "name": "Listings",
      "item": [
        {
          "name": "Get all listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"price is a number, not a string\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b[0].price).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"category is lowercase\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b[0].category).to.equal(b[0].category.toLowerCase());",
                  "});",
                  "pm.test(\"datePosted is an ISO timestamp\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b[0].datePosted).to.match(/^\\d{4}-\\d{2}-\\d{2}T/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
